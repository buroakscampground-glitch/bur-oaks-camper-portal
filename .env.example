# Optional: add these values in the hosting dashboard to activate measurement and verification.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=your-google-search-console-verification-token
NEXT_PUBLIC_TAWK_PROPERTY_ID=your-tawk-property-id
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# Server-only provider settings. Configure these in Vercel; never expose them with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_webhook_secret
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-server-only-twilio-token
TWILIO_PHONE_NUMBER=+16185551234
TAWK_WEBHOOK_SECRET=your-server-only-tawk-webhook-secret
TAWK_CHAT_ALERT_PHONE=+16188828063
SENDGRID_API_KEY=SG.server-only-key
NEXT_PUBLIC_SITE_URL=https://www.buroakscampground.com
