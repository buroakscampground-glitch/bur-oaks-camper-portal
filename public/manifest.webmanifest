{
  "name": "Bur Oaks Camper App",
  "short_name": "Bur Oaks",
  "description": "The Bur Oaks Campground camper portal for invoices, weather, maintenance, events, documents, and office messages.",
  "id": "/portal",
  "start_url": "/portal?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f4f1e9",
  "theme_color": "#173722",
  "orientation": "portrait",
  "categories": ["lifestyle", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pay invoices",
      "short_name": "Invoices",
      "description": "Open your Bur Oaks invoices and AutoPay.",
      "url": "/invoices",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Maintenance request",
      "short_name": "Maintenance",
      "description": "Submit or check a maintenance request.",
      "url": "/maintenance",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Saturday dinners",
      "short_name": "Dinners",
      "description": "See the Saturday dinner menu.",
      "url": "/dinners",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
